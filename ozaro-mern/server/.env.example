# Server port
PORT=8000
# MongoDB connection (leave empty to use the built-in embedded MongoDB for local testing)
MONGODB_URI=
MONGODB_DB=ozora
# Change these before going live
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@ozorazylife.com
ADMIN_PASSWORD=Ozora@2026
# Allowed frontend origin(s), comma separated. Empty = allow all
CORS_ORIGIN=
# Where uploaded images/PDFs are stored
UPLOAD_DIR=./uploads
# Embedded DB data folder (only used when MONGODB_URI is empty)
EMBEDDED_DB_PATH=./data
